{
  "name": "aidocready",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "aidocready": "dist/cli.js"
  },
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "profiles",
    "templates",
    "skills",
    "README.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc && node scripts/export-profiles.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm test && npm run check:meta && npm run build && npm run test:corpus && npm run test:package",
    "test:corpus": "node scripts/check-corpus.mjs",
    "check:meta": "tsc && node scripts/export-profiles.mjs --check",
    "test:package": "node scripts/check-package.mjs",
    "check:site": "node scripts/check-site-sync.mjs && node scripts/build-site.mjs",
    "check:site-release": "node scripts/check-site-release.mjs",
    "test:agents": "node evals/format-selection/run.mjs"
  },
  "dependencies": {
    "kordoc": "4.21.9",
    "remark-parse": "11.0.0",
    "remark-gfm": "4.0.1",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "tsx": "^4.20.6",
    "@types/node": "^20.19.0",
    "jszip": "3.10.1"
  },
  "description": "Deterministic AI-friendly report linting for Markdown and HWPX, powered by Kordoc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roboco-io/aidocready.git"
  },
  "homepage": "https://github.com/roboco-io/aidocready#readme",
  "bugs": {
    "url": "https://github.com/roboco-io/aidocready/issues"
  },
  "keywords": [
    "ai",
    "report",
    "lint",
    "markdown",
    "hwpx",
    "kordoc"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
